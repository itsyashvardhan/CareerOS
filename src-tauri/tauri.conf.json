{
  "productName": "CareerOS",
  "version": "1.0.0",
  "identifier": "com.careeros.app",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "CareerOS",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_OUTPUT_OF: tauri signer generate",
      "endpoints": [
        "https://github.com/itsyashvardhan/careeros/releases/latest/download/latest.json"
      ]
    }
  }
}
